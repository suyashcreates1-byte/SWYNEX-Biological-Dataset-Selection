      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Input the exact data from Task 2\n",
        "bases = ['Adenine (A)', 'Thymine (T)', 'Cytosine (C)', 'Guanine (G)']\n",
        "counts = [8954, 9594, 5492, 5863]\n",
        "colors = ['#ff9999', '#66b3ff', '#99ff99', '#ffcc99']\n",
        "\n",
        "# 2. Build the bar chart\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.bar(bases, counts, color=colors, edgecolor='black')\n",
        "plt.title('SARS-CoV-2 Nucleotide Frequencies', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Nucleotide Base', fontsize=12)\n",
        "plt.ylabel('Frequency (Count)', fontsize=12)\n",
        "\n",
        "# 3. Add the exact numbers on top of the bars\n",
        "for i, v in enumerate(counts):\n",
        "    plt.text(i, v + 100, str(v), ha='center', fontweight='bold')\n",
        "\n",
        "# 4. Save and display\n",
        "plt.tight_layout()\n",
        "plt.savefig('sars_cov_2_chart.png')\n",
        "plt.show()"
      ]
